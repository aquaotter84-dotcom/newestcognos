# COGNOS environment variables
# Copy to .env for local dev; set the same values in Vercel (Settings > Environment Variables)
# Never commit .env or real credentials.

# PostgreSQL connection string (Neon pooled, Supabase, or any Postgres)
# For Vercel use the POOLED (pooler) string from Neon:
#   Project -> Connect -> Connection string -> Pooled
# Example: postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Vercel Cron secret. Add the same value in Vercel:
#   Settings -> Cron Jobs -> Secret
#   Settings -> Environment Variables -> CRON_SECRET
# Vercel sends it as `Authorization: Bearer <CRON_SECRET>` to /api/insights/briefing.
CRON_SECRET=

# Optional PostgreSQL pool tuning (Vercel/Neon friendly):
# DATABASE_POOL_MAX=10
# DATABASE_POOL_IDLE_MS=30000
# DATABASE_CONNECTION_TIMEOUT_MS=10000

# BluesMinds API key (OpenAI-compatible provider)
BLUESMINDS_API_KEY=

# Optional overrides:
# BLUESMINDS_MODEL=gpt_5_4
# BLUESMINDS_API_URL=https://api.bluesminds.com/v1/chat/completions

# Optional council behavior:
# MEMORY_EXTRACTION=true
# COUNCIL_MAX_REVISIONS=1
# COUNCIL_REVISION_THRESHOLD=70

# Web search is available through the chat "Web search" toggle.
# Without a provider key COGNOS falls back to DuckDuckGo HTML search.
# To use a dedicated provider instead, set:
# WEB_SEARCH_PROVIDER=tavily
# TAVILY_API_KEY=
# or
# WEB_SEARCH_PROVIDER=exa
# EXA_API_KEY=
