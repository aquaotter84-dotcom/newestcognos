# COGNOS environment variables
# Copy to .env for local development; set the same values in Vercel
# (Settings > Environment Variables). Never commit .env or real secrets.

# BluesMinds API key (OpenAI-compatible provider)
BLUESMINDS_API_KEY=

# Council model (default: gpt-4o-mini)
BLUESMINDS_MODEL=

# PostgreSQL connection string (Neon pooled string on Vercel)
DATABASE_URL=

# Optional: when set, all /api routes require the matching header
# `x-cognos-secret`. Server-side only — there is no UI for it.
COGNOS_RUNTIME_SECRET=
